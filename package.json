{
  "name": "mokhwan",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pretypecheck": "npm run build -w mokhwan-engine",
    "typecheck": "tsc --noEmit -p packages/engine && tsc --noEmit -p tsconfig.check.json",
    "test": "npm run typecheck && vitest run",
    "test:watch": "vitest",
    "test:smoke": "node app/test/smoke.spec.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright-core": "^1.49.1",
    "typescript": "5.7.3",
    "vite": "^6.0.7",
    "vitest": "3.0.5"
  }
}
