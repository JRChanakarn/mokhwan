{
  "name": "mokhwan-engine",
  "version": "0.1.0",
  "description": "เอนจินคำนวณการฟุ้งกระจาย PM2.5 จากการเผาในที่โล่ง — Gaussian plume + Lagrangian puff พร้อมสนามลมจากภูมิประเทศ",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    },
    "./worker": "./src/worker.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "vite build --watch",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JRChanakarn/mokhwan.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/JRChanakarn/mokhwan#readme",
  "bugs": {
    "url": "https://github.com/JRChanakarn/mokhwan/issues"
  },
  "author": "JRChanakarn",
  "keywords": [
    "pm2.5",
    "air-quality",
    "dispersion",
    "gaussian-plume",
    "smoke",
    "biomass-burning",
    "thailand",
    "haze"
  ],
  "devDependencies": {
    "typescript": "5.7.3",
    "vite": "6.0.7"
  }
}
